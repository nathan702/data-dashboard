# Firebase web config (Firebase console → Project settings → Your apps).
# These values identify the project; they are not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Google Workspace domain; the sign-in screen only offers accounts from it.
VITE_GOOGLE_WORKSPACE_DOMAIN=calleva.org
# Local development only: skip sign-in (pair with AUTH_DISABLED=1 on the API).
VITE_AUTH_DISABLED=0

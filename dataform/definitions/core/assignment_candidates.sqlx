config {
  type: "table",
  schema: "marts",
  description: "Every value that can be assigned to a business line (each Square location, Campminder session group, ...), with recent activity to help prioritize and an optional default.",
  assertions: { uniqueKey: ["source", "kind", "assign_key"] }
}

WITH square AS (
  SELECT
    l.location_id AS assign_key,
    COALESCE(l.location_name, l.location_id) AS label,
    MAX(o.sale_date) AS last_activity,
    COALESCE(SUM(IF(o.sale_date >= DATE_SUB(CURRENT_DATE("America/New_York"), INTERVAL 12 MONTH), o.gross - o.discounts, 0)), 0) AS net_12m,
    COALESCE(SUM(IF(o.sale_date >= DATE_SUB(CURRENT_DATE("America/New_York"), INTERVAL 12 MONTH), o.orders, 0)), 0) AS activity_12m,
    CAST(NULL AS STRING) AS default_hint
  FROM ${ref("stg_square_locations")} AS l
  LEFT JOIN (
    SELECT o.location_id, o.sale_date, SUM(li.gross) AS gross, SUM(li.discounts) AS discounts, COUNT(DISTINCT o.order_id) AS orders
    FROM ${ref("stg_square_orders")} AS o
    JOIN ${ref("stg_square_line_items")} AS li USING (order_id)
    GROUP BY 1, 2
  ) AS o USING (location_id)
  GROUP BY 1, 2
),
shopify AS (
  SELECT
    'store' AS assign_key,
    'Shopify store' AS label,
    MAX(sale_date) AS last_activity,
    COALESCE(SUM(IF(sale_date >= DATE_SUB(CURRENT_DATE("America/New_York"), INTERVAL 12 MONTH), gross - discounts, 0)), 0) AS net_12m,
    COUNT(DISTINCT IF(sale_date >= DATE_SUB(CURRENT_DATE("America/New_York"), INTERVAL 12 MONTH), order_id, NULL)) AS activity_12m,
    CAST(NULL AS STRING) AS default_hint
  FROM ${ref("stg_shopify_order_lines")}
),
campminder AS (
  -- Session groups: session names without the week ("Farm Week 9" → "Farm").
  -- Weekly summer sessions default to Camp; everything else is assigned on Settings.
  SELECT
    session_group AS assign_key,
    session_group AS label,
    MAX(COALESCE(session_start, application_date)) AS last_activity,
    CAST(0 AS NUMERIC) AS net_12m,
    COUNTIF(status_code = 'EN' AND COALESCE(session_start, application_date) >= DATE_SUB(CURRENT_DATE("America/New_York"), INTERVAL 12 MONTH)) AS activity_12m,
    IF(LOGICAL_OR(is_weekly), 'camp', NULL) AS default_hint
  FROM ${ref("stg_campminder_sessions")}
  WHERE session_group IS NOT NULL
  GROUP BY 1, 2
),
campminder_money AS (
  -- Session groups that only appear in the Financial report, and financial
  -- categories for lines without a session (Miscellaneous and System go by the
  -- household instead; see stg_campminder_transactions).
  SELECT
    assign_key,
    IF(STARTS_WITH(assign_key, 'category:'), CONCAT('Financial category: ', SUBSTR(assign_key, 10)), assign_key) AS label,
    MAX(COALESCE(service_start, post_date)) AS last_activity,
    COALESCE(SUM(IF(type IN ('debit', 'credit') AND post_date >= DATE_SUB(CURRENT_DATE("America/New_York"), INTERVAL 12 MONTH), amount, 0)), 0) AS net_12m,
    COUNTIF(type = 'debit' AND amount > 0 AND post_date >= DATE_SUB(CURRENT_DATE("America/New_York"), INTERVAL 12 MONTH)) AS activity_12m,
    CASE assign_key
      WHEN 'category:Summer Camp' THEN 'camp'
      WHEN 'category:LIT' THEN 'camp'
      WHEN 'category:CHAPS' THEN 'chaps'
      WHEN 'category:Extracurricular' THEN 'school_year'
      WHEN 'category:River School' THEN 'river_school'
    END AS default_hint
  FROM ${ref("stg_campminder_transactions")}
  WHERE assigned_by IN ('session', 'category')
    AND assign_key NOT IN (SELECT assign_key FROM campminder)
  GROUP BY 1, 2
),
fareharbor AS (
  -- One FareHarbor company per business line; matched by its shortname until set on Settings.
  SELECT
    c.assign_key,
    c.assign_key AS label,
    MAX(b.service_date) AS last_activity,
    COALESCE(SUM(IF(b.status IS DISTINCT FROM 'rebooked' AND b.service_date >= DATE_SUB(CURRENT_DATE("America/New_York"), INTERVAL 12 MONTH), b.net, 0)), 0) AS net_12m,
    COUNTIF(b.status IN ('active', 'uncancelled') AND b.service_date >= DATE_SUB(CURRENT_DATE("America/New_York"), INTERVAL 12 MONTH)) AS activity_12m,
    CASE
      WHEN REGEXP_CONTAINS(c.assign_key, r'haunt') THEN 'haunted_forest'
      WHEN REGEXP_CONTAINS(c.assign_key, r'river') THEN 'river_school'
      WHEN REGEXP_CONTAINS(c.assign_key, r'event') THEN 'events'
    END AS default_hint
  FROM (SELECT DISTINCT record_id AS assign_key FROM ${ref("raw_fareharbor", "companies")}) AS c
  LEFT JOIN ${ref("stg_fareharbor_bookings")} AS b ON b.company = c.assign_key
  GROUP BY 1, 2
),
hubspot AS (
  -- Deal pipelines; matched by name until set on Settings.
  SELECT
    p.assign_key,
    COALESCE(p.label, p.assign_key) AS label,
    MAX(d.service_date) AS last_activity,
    COALESCE(SUM(IF(d.is_won AND d.close_date >= DATE_SUB(CURRENT_DATE("America/New_York"), INTERVAL 12 MONTH), d.amount, 0)), 0) AS net_12m,
    COUNTIF(d.is_won AND d.close_date >= DATE_SUB(CURRENT_DATE("America/New_York"), INTERVAL 12 MONTH)) AS activity_12m,
    CASE
      WHEN REGEXP_CONTAINS(LOWER(ANY_VALUE(p.label)), r'chap') THEN 'chaps'
      WHEN REGEXP_CONTAINS(LOWER(ANY_VALUE(p.label)), r'educat|field trip|school') THEN 'education'
    END AS default_hint
  FROM (
    SELECT JSON_VALUE(payload, '$.id') AS assign_key, JSON_VALUE(payload, '$.label') AS label
    FROM ${ref("raw_hubspot", "pipelines")}
    WHERE TRUE
    QUALIFY ROW_NUMBER() OVER (PARTITION BY record_id ORDER BY source_updated_at DESC, ingested_at DESC) = 1
  ) AS p
  LEFT JOIN ${ref("stg_hubspot_deals")} AS d ON d.pipeline_id = p.assign_key
  GROUP BY 1, 2
)
SELECT 'square' AS source, 'location' AS kind, * FROM square
UNION ALL
SELECT 'shopify', 'store', * FROM shopify
UNION ALL
SELECT 'campminder', 'session', * FROM campminder
UNION ALL
SELECT 'campminder', IF(STARTS_WITH(assign_key, 'category:'), 'category', 'session'), * FROM campminder_money
UNION ALL
SELECT 'fareharbor', 'company', * FROM fareharbor
UNION ALL
SELECT 'hubspot', 'pipeline', * FROM hubspot
